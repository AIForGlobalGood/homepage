---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects')).sort((a, b) => {
  const order = { active: 0, shipped: 1, proposal: 2, archived: 3 };
  return (order[a.data.status] ?? 9) - (order[b.data.status] ?? 9);
});
---
<BaseLayout title="Projects" description="Projects we're building, proposing, or have shipped.">
  <h1>Projects</h1>

  <p class="text-muted">
    We mark each project with a status so it's clear what's an idea, what's being built, and what's live.
  </p>

  {projects.length === 0 ? (
    <div class="empty-state">
      <p><strong>No projects to show yet.</strong></p>
      <p>Have one in mind? <a href="/get-involved#propose-a-project">Propose a project</a>.</p>
    </div>
  ) : (
    <ul class="card-list">
      {projects.map((p) => (
        <li>
          <a class="card" href={`/projects/${p.id}`}>
            <h3>{p.data.title}</h3>
            <p>{p.data.summary}</p>
            <div class="card-meta">
              <span class={`status status-${p.data.status}`}>{p.data.status}</span>
              {p.data.tags?.map((t) => <span>#{t}</span>)}
            </div>
          </a>
        </li>
      ))}
    </ul>
  )}
</BaseLayout>
